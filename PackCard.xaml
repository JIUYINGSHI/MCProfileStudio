<UserControl x:Class="McProfileStudio.PackCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:McProfileStudio"
             Height="74" MinWidth="0" HorizontalAlignment="Stretch"
             ToolTipService.InitialShowDelay="650" ToolTipService.ShowDuration="30000">
  <Border Background="#6A292929" CornerRadius="8" ClipToBounds="True">
    <Grid Margin="8,7">
      <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="60" Height="60" CornerRadius="4" ClipToBounds="True" Background="#353A3A3A" VerticalAlignment="Stretch">
        <Image Source="{Binding PreviewImage}" Stretch="UniformToFill">
          <Image.ToolTip><StackPanel><local:MinecraftTextBlock MinecraftText="{Binding Name}" Foreground="White" FontWeight="SemiBold"/><Image Source="{Binding PreviewImage}" Width="160" Height="160" Stretch="Uniform" Margin="0,8,0,0"/></StackPanel></Image.ToolTip>
        </Image>
      </Border>
      <Border Grid.Column="1" Margin="8,0,0,0" Height="60" VerticalAlignment="Center" CornerRadius="4" ClipToBounds="True" Background="#B91D1D1D">
        <Grid>
          <Image Source="{Binding BannerImage}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" MaxHeight="60" RenderOptions.BitmapScalingMode="NearestNeighbor">
            <Image.ToolTip><Image Source="{Binding BannerImage}" MaxWidth="720" MaxHeight="180" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Image.ToolTip>
            <Image.Style><Style TargetType="Image"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFontBanner}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Image.Style>
          </Image>
          <Border>
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding IsFontBanner}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#F20B131C" Offset="0"/><GradientStop Color="#B90B131C" Offset="0.48"/><GradientStop Color="#280B131C" Offset="1"/>
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <StackPanel Margin="14,7,12,6" VerticalAlignment="Center">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsFontBanner}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
            <local:MinecraftTextBlock MinecraftText="{Binding Name}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="38">
              <local:MinecraftTextBlock.ToolTip><local:MinecraftTextBlock MinecraftText="{Binding Name}" Foreground="White" FontSize="13" MaxWidth="560" TextWrapping="Wrap"/></local:MinecraftTextBlock.ToolTip>
            </local:MinecraftTextBlock>
            <local:MinecraftTextBlock MinecraftText="{Binding Description}" Foreground="#EAF4FF" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
              <local:MinecraftTextBlock.ToolTip><local:MinecraftTextBlock MinecraftText="{Binding Description}" Foreground="White" FontSize="13" MaxWidth="560" TextWrapping="Wrap"/></local:MinecraftTextBlock.ToolTip>
            </local:MinecraftTextBlock>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</UserControl>
