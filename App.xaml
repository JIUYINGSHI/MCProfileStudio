<Application x:Class="McProfileStudio.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <FontFamily x:Key="AppFont">pack://application:,,,/Assets/#Maple Mono Normal NF CN</FontFamily>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="#F7FAFF"/></Style>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/></Style>
    <Style TargetType="Button"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#2678D4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="15,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#55101820"/><Setter Property="BorderBrush" Value="#35FFFFFF"/><Setter Property="Padding" Value="11,8"/><Setter Property="CaretBrush" Value="White"/></Style>
    <Style TargetType="ComboBox"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="#F4F8FF"/><Setter Property="Background" Value="#E0202B38"/><Setter Property="BorderBrush" Value="#35FFFFFF"/><Setter Property="Padding" Value="10,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><Grid><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" TextElement.Foreground="#F4F8FF" TextElement.FontFamily="{StaticResource AppFont}" VerticalAlignment="Center" Margin="0,0,24,0"/><TextBlock Text="⌄" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#AFC7DD"/></Grid></Border></ToggleButton><Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#F018222E" BorderBrush="#5531B7FF" BorderThickness="1" CornerRadius="10" Padding="5" Width="{TemplateBinding ActualWidth}" MaxHeight="420" ClipToBounds="True"><ScrollViewer><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F4F8FF"/><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Background" Value="#F018222E"/><Setter Property="Padding" Value="12,8"/><Setter Property="MaxWidth" Value="420"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="White"/><Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/></Style>
    <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Background" Value="#281A2430"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="4"/></Style>
    <Style TargetType="ToolTip"><Setter Property="FontFamily" Value="{StaticResource AppFont}"/><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#F014202C"/><Setter Property="BorderBrush" Value="#7031B7FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12"/><Setter Property="HasDropShadow" Value="True"/><Setter Property="Placement" Value="Mouse"/><Setter Property="HorizontalOffset" Value="12"/><Setter Property="VerticalOffset" Value="12"/><Setter Property="ToolTipService.InitialShowDelay" Value="650"/><Setter Property="ToolTipService.ShowDuration" Value="30000"/></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/><Setter Property="Background" Value="#25000000"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb MinHeight="36" MinWidth="36"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#CC31B7FF" CornerRadius="5" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="MinWidth" Value="0"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/></Trigger><Trigger Property="Orientation" Value="Vertical"><Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
