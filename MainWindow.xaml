<Window x:Class="McProfileStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:McProfileStudio" Title="MC Profile Studio" Icon="Assets/app.ico" Width="1380" Height="880" MinWidth="1120" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="#10101820" Foreground="#F4F8FF">
 <Window.Resources>
  <Style x:Key="Nav" TargetType="RadioButton"><Setter Property="Foreground" Value="#DCE6F2"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Bd" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3"/><ColumnDefinition/></Grid.ColumnDefinitions><Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2" Background="#00A8FF" Visibility="Collapsed"/><ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#18FFFFFF"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="Background" Value="#20FFFFFF"/><Setter TargetName="Bd" Property="BorderBrush" Value="#24FFFFFF"/><Setter TargetName="Indicator" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{StaticResource PanelBrush}"/><Setter Property="BorderBrush" Value="{StaticResource GlassLineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="ClipToBounds" Value="True"/></Style>
  <Style x:Key="SmallLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#8FFFFFFF"/><Setter Property="FontSize" Value="12"/></Style>
  <Style x:Key="TitleBarButton" TargetType="Button"><Setter Property="Width" Value="46"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,0"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
  <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}"><Setter Property="FontSize" Value="20"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/></Trigger></Style.Triggers></Style>
 </Window.Resources>
 <Grid><Grid.Background><ImageBrush ImageSource="Assets/background.jpg" Stretch="UniformToFill" Opacity="0.48"/></Grid.Background><Border Background="#82000000"/><Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#B8141414" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid Margin="18,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/mc-profile-icon.png" Width="28" Height="28" Margin="0,0,11,0"/><TextBlock Text="MC Profile Studio" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="Minecraft Profile Manager" Foreground="#8FFFFFFF" FontSize="11" Margin="12,1,0,0" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource TitleBarButton}" Content="—" Click="MinimizeWindow_Click"/><Button Style="{StaticResource TitleBarButton}" Content="□" Click="MaximizeWindow_Click"/><Button Style="{StaticResource TitleBarCloseButton}" Content="×" Click="CloseWindow_Click"/></StackPanel></Grid></Border>
  <Border Grid.Row="1" Margin="18,12,18,18" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource GlassLineBrush}" BorderThickness="1" CornerRadius="22" ClipToBounds="True"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#18000000" BorderBrush="#24FFFFFF" BorderThickness="0,0,1,0" Padding="16"><DockPanel><StackPanel DockPanel.Dock="Top"><RadioButton Style="{StaticResource Nav}" Content="概览" IsChecked="True" Checked="Navigate" Tag="0"/><RadioButton Style="{StaticResource Nav}" Content="资源包" Checked="Navigate" Tag="1"/><RadioButton Style="{StaticResource Nav}" Content="光影包" Checked="Navigate" Tag="2"/><RadioButton Style="{StaticResource Nav}" Content="键位配置" Checked="Navigate" Tag="3"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock Text="当前实例" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="InstanceLabel" Text="尚未导入" Foreground="#E6EEF8" TextWrapping="Wrap" Margin="0,6,0,12"/><Button Content="选择实例" Click="PickInstance_Click"/></StackPanel></DockPanel></Border>
  <Grid Grid.Column="1" Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18"><StackPanel><TextBlock x:Name="PageTitle" Text="概览" Foreground="White" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="选择整合包实例，然后统一应用资源与键位。" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0"/></StackPanel><Button x:Name="ApplyInstanceButton" DockPanel.Dock="Right" Content="应用到当前实例" Click="Apply_Click" Background="#12FFFFFF" MinWidth="150" VerticalAlignment="Center" Visibility="Collapsed"/></DockPanel>
   <Grid Grid.Row="1">
    <Grid x:Name="HomePage"><StackPanel><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="开始使用" Foreground="White" FontSize="20"/><TextBlock Text="只改资源包、光影与键位；写入 options.txt 前自动备份。" Foreground="#BAC7D8" Margin="0,8,0,18"/><WrapPanel><Button Content="选择固定资源包目录" Click="PickPackLibrary_Click" Margin="0,0,10,0"/><Button Content="选择固定光影包目录" Click="PickShaderLibrary_Click" Background="#38383838"/></WrapPanel></StackPanel></Border><UniformGrid Columns="3"><Border Style="{StaticResource Card}" Margin="0,0,10,14"><StackPanel><TextBlock Text="资源包" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="PackCount" Text="0" Foreground="White" FontSize="34"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="5,0,5,14"><StackPanel><TextBlock Text="有键位的 Mod" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="ModCount" Text="0" Foreground="White" FontSize="34"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="10,0,0,14"><StackPanel><TextBlock Text="键位 / 冲突" Style="{StaticResource SmallLabel}"/><TextBlock x:Name="KeyCount" Text="0 / 0" Foreground="White" FontSize="34"/></StackPanel></Border></UniformGrid><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="固定目录" Foreground="White" FontSize="18"/><TextBlock x:Name="LibrarySummary" Foreground="#BAC7D8" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></Grid>
    <Grid x:Name="PacksPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><TextBlock DockPanel.Dock="Top" Text="可用资源包（上方优先级更高）" Foreground="White" FontSize="18" Margin="0,0,0,12"/><ListBox x:Name="PackList" AllowDrop="True" PreviewMouseLeftButtonDown="PackList_MouseDown" Drop="PackList_Drop" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#65272727" CornerRadius="8" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="116"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Grid.Column="1" Width="104" Height="52" CornerRadius="5" ClipToBounds="True"><Grid><Border Background="#353A3A3A"/><Image Source="{Binding PreviewImage}" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="#F8FBFF" FontSize="14" TextTrimming="CharacterEllipsis"/><local:MinecraftTextBlock MinecraftText="{Binding Description}" Style="{StaticResource SmallLabel}" TextTrimming="CharacterEllipsis" MaxWidth="650"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,14"><StackPanel><TextBlock Text="资源包库" Foreground="White" FontSize="18"/><TextBlock x:Name="PackPathText" Foreground="#BAC7D8" TextWrapping="Wrap" Margin="0,8,0,14"/><Button Content="更改目录" Click="PickPackLibrary_Click"/><TextBlock Text="读取 pack.png 与 pack.mcmeta，排列方式与游戏内相同；不判断版本兼容。" TextWrapping="Wrap" Foreground="#93A4B8" Margin="0,16,0,0"/></StackPanel></Border></Grid>
    <Grid x:Name="ShadersPage" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="光影包" Foreground="White" FontSize="20"/><TextBlock Text="选择要应用的光影；每个光影可以指定自己的实机效果图。" Foreground="#BAC7D8" Margin="0,5,0,14"/></StackPanel><ListBox x:Name="ShaderList" SelectionChanged="ShaderList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Background="#65272727" CornerRadius="10" Padding="8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="140" Height="80" CornerRadius="7" ClipToBounds="True"><Grid><Border Background="#242A2A2A"/><Image Source="{Binding PreviewImage}" Stretch="Uniform"/></Grid></Border><StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Foreground="White" FontSize="14" TextWrapping="Wrap"/><TextBlock Text="点击选择" Style="{StaticResource SmallLabel}" Margin="0,6,0,0"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,14"><StackPanel><TextBlock Text="效果预览" Foreground="White" FontSize="18"/><Border Margin="0,14" Height="240" CornerRadius="12" ClipToBounds="True"><Grid><Border Background="#262E2E2E"/><Image x:Name="ShaderPreview" Stretch="UniformToFill"/><TextBlock x:Name="ShaderPreviewEmpty" Text="暂未设置效果图" Foreground="#9EADBF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><TextBlock x:Name="SelectedShaderName" Text="请选择一个光影包" Foreground="#EAF3FF" TextWrapping="Wrap" Margin="0,0,0,12"/><Button Content="为这个光影选择效果图" Click="PickShaderPreview_Click"/><Button Content="更改光影包目录" Click="PickShaderLibrary_Click" Background="#38383838" Margin="0,9,0,0"/></StackPanel></Border></Grid>
    <Grid x:Name="KeysPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Border Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/><ColumnDefinition Width="220"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="KeySearch" TextChanged="KeyFilterChanged" ToolTip="搜索功能、Mod 或按键"/><ComboBox Grid.Column="1" x:Name="ModFilter" Margin="10,0" SelectionChanged="KeyFilterChanged"/><ComboBox Grid.Column="2" x:Name="LayoutCombo" Margin="0,0,10,0" SelectionChanged="LayoutCombo_SelectionChanged"/><CheckBox Grid.Column="3" x:Name="ConflictOnly" Content="仅冲突" Checked="KeyFilterChanged" Unchecked="KeyFilterChanged" VerticalAlignment="Center"/></Grid></Border><Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" ClipToBounds="True"><Viewbox x:Name="InputViewbox" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><StackPanel x:Name="KeyboardPanel" VerticalAlignment="Center"/><Canvas x:Name="MousePanel" Width="152" Height="218" Margin="18,0,0,0" VerticalAlignment="Center"/></StackPanel></Viewbox></Border><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="1.65*"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}"><ListBox x:Name="KeyList" SelectionChanged="KeyList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding FunctionDisplay}" Foreground="#F7FAFF" TextWrapping="Wrap"/><TextBlock Text="{Binding OptionKey}" Style="{StaticResource SmallLabel}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding ModDisplayName}" Foreground="#63C9FF" TextWrapping="Wrap"/><TextBlock Text="前置 / 依赖库" Foreground="#FFC56A" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLibrary}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><TextBlock Grid.Column="2" Text="{Binding KeyLabel}" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,14"><ScrollViewer><StackPanel><TextBlock Text="按键占用详情" Foreground="White" FontSize="18"/><TextBlock x:Name="SelectedKeyName" Text="点击上方键帽或鼠标按键查看全部占用功能，或在左侧选择一项编辑。" Foreground="#D5E0ED" Margin="0,12,0,4" TextWrapping="Wrap"/><TextBlock x:Name="SelectedKeyMod" Foreground="#63C9FF" TextWrapping="Wrap"/><ItemsControl x:Name="KeyOccupancyList" Margin="0,12"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#4C303030" CornerRadius="8" Padding="10" Margin="0,0,0,7"><StackPanel><TextBlock Text="{Binding FunctionDisplay}" Foreground="White" TextWrapping="Wrap"/><TextBlock Text="{Binding ModDisplayName}" Foreground="#63C9FF" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><Button x:Name="CaptureButton" Content="点击后按下新按键" Click="CaptureButton_Click" Margin="0,8,0,8" PreviewKeyDown="CaptureButton_KeyDown"/><Button Content="清除绑定" Click="ClearKey_Click" Background="#38383838"/><CheckBox x:Name="RememberKey" Content="记住为此 Mod 的专属键位" Checked="RememberKey_Changed" Unchecked="RememberKey_Changed" Margin="0,14,0,0"/><TextBlock Text="键盘与鼠标左、中、右及两个侧键都会参与占用和冲突检测。" Foreground="#93A4B8" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border></Grid></Grid>
   </Grid><TextBlock Grid.Row="2" x:Name="StatusText" Text="就绪" Foreground="#A8B7C9" Margin="0,8,0,0"/>
  </Grid></Grid></Border>
 </Grid></Grid>
</Window>
